# Realmweaver runs without any keys in Demo mode (a scripted narrator and painted scene cards).
# Put real keys in .env.local (never committed), not in this file.

# The narrator: Claude if ANTHROPIC_API_KEY is set, otherwise Gemini if GEMINI_API_KEY is set.
# Optional: force one with REALMWEAVER_NARRATOR=claude, gemini or demo.
# REALMWEAVER_NARRATOR=

# Claude narrates the story and builds worlds.
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default claude-opus-5-5) and effort per turn (default low).
# REALMWEAVER_MODEL=claude-opus-5-5
# REALMWEAVER_EFFORT=low

# Gemini paints scene illustrations and hero portraits, and narrates when there is no Claude key.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
