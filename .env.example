# Realmweaver runs without any keys in Demo mode (a scripted narrator and painted scene cards).

# Claude narrates the story, runs the rules and builds worlds.
ANTHROPIC_API_KEY=
# Optional: override the narrator model (default claude-opus-5-5) and effort (default low).
# REALMWEAVER_MODEL=claude-opus-5-5
# REALMWEAVER_EFFORT=low

# Optional: Gemini paints scene illustrations and hero portraits.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
