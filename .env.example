# === Authentication (Required) ===

# Random secret for signing tokens (generate with: openssl rand -base64 32)
AUTH_SECRET=your_random_secret_here

# Google OAuth credentials (get from https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here

# === LLM Provider (pick one for text generation) ===

# Option 1: Groq (recommended - generous free tier, 14,400 req/day)
# Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: Google Gemini (used as fallback if GROQ_API_KEY is not set)
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# === Image Generation (Gemini required for images) ===
# If you want AI-generated scene illustrations, you need a Gemini key too.
# The app works without it — images just won't generate.
GEMINI_API_KEY=your_gemini_api_key_here
